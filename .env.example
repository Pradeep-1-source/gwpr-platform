# ==============================================================================
# GWPR Private Limited — Environment Variables Template
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (safe to use in frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Custom Base Verification URL (default is current window.location.origin)
VITE_BASE_URL=https://your-domain.vercel.app
